---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
import { profile } from '../data/profile';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    stack: entry.data.stack,
    year: entry.data.year,
    link: entry.data.link,
    repo: entry.data.repo,
  }));
---

<BaseLayout
  title={`${profile.displayName} — terminal`}
  description="Moksha Gunarathne — full-stack developer. An interactive terminal portfolio: type commands like whoami, projects, contact or help."
>
  <main class="page">
    <p class="boot-line">
      Last login: <span data-last-login>{new Date().toDateString()}</span> on ttys001
    </p>

    <Terminal profile={profile} projects={projects} />

    <p class="page-tip">
      <span class="t-dim">tip:</span> type <span class="t-code">help</span> for commands,
      <span class="t-code">projects</span> to list work, or <span class="t-code">open 1</span> to inspect a project.
    </p>

    <footer class="page-footer">
      <p>// © {new Date().getFullYear()} — built with astro + tailwind</p>
      <p>press ctrl +c to exit (just kidding)</p>
    </footer>
  </main>
</BaseLayout>
