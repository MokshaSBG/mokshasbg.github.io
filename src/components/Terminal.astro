---
import '../styles/terminal.css';
import { promptHtml, renderInitialTranscript } from '../lib/commands';
import type { Profile, Project } from '../lib/types';

interface Props {
  profile: Profile;
  projects: Project[];
}

const { profile, projects } = Astro.props;

const initialTranscript = renderInitialTranscript({
  profile,
  projects,
  history: [],
  sessionStart: Date.now(),
});

// Escape "<" so content containing "</script>" cannot break out of the JSON block.
const terminalDataJson = JSON.stringify({ profile, projects }).replace(/</g, '\\u003c');
---

<section class="terminal" id="terminal" aria-label="Interactive portfolio terminal">
  <header class="term-bar">
    <span class="term-dot term-dot--red" aria-hidden="true"></span>
    <span class="term-dot term-dot--yellow" aria-hidden="true"></span>
    <span class="term-dot term-dot--green" aria-hidden="true"></span>
    <span class="term-title">{profile.user}@{profile.host}: {profile.path}</span>
  </header>

  <div class="term-screen">
    <div
      id="term-output"
      role="log"
      aria-live="polite"
      aria-relevant="additions"
      aria-label="Terminal output"
      set:html={initialTranscript}
    ></div>

    <div class="term-input-row" id="term-input-row">
      <span set:html={promptHtml(profile)} aria-hidden="true"></span>
      <span class="term-line">
        <span class="term-typed" id="term-typed" aria-hidden="true"></span>
        <span class="term-caret" aria-hidden="true"></span>
      </span>
      <input
        id="term-input"
        class="term-hidden-input"
        type="text"
        aria-label="Type a command and press Enter. Type help to list commands."
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="send"
      />
    </div>

    <noscript>
      <p class="term-noscript">
        JavaScript is off, so the prompt is not interactive — but every link in the transcript above still works.
      </p>
    </noscript>
  </div>
</section>

<script type="application/json" id="term-data" is:inline set:html={terminalDataJson}></script>
<script>
  import { initTerminal } from '../lib/terminal';

  initTerminal();
</script>
