---
interface Props {
  user?: string;
  host?: string;
}

const { user = 'guest', host = 'portfolio' } = Astro.props;
---

<div class="terminal-window border border-term-dim rounded-md bg-term-bgAlt shadow-[0_0_30px_rgba(51,255,51,0.15)]">
  <div class="terminal-header flex items-center gap-2 px-3 py-2 border-b border-term-dim bg-black">
    <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
    <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
    <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
    <span class="ml-4 text-xs text-term-dim">
      {user}@{host}: ~
    </span>
  </div>
  <div class="p-4 md:p-6">
    <slot />
  </div>
</div>
